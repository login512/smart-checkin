# Server
PORT=3512
PUBLIC_BASE_URL=http://localhost:3512

# Default Industry Preset: classroom | workplace | event | checkpoint | dev-reference
DEFAULT_PRESET=classroom
DEFAULT_LANG=th

# Login512 Credentials (get your Free Forever keys at https://login512.com/portal/index.html)
# NEVER commit your real l512_sk_... key to git or expose it to browser JavaScript!
LOGIN512_ENDPOINT=https://api.login512.com
LOGIN512_SDK_URL=https://login512.com/sdk/login512-sdk.js
LOGIN512_PUBLISHABLE_KEY=l512_pk_replace_with_your_publishable_key
LOGIN512_SECRET_KEY=l512_sk_replace_with_your_secret_key

# Security & Session
# Set a fixed 64-hex random string in production (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
SESSION_SECRET=
# Optional First-Time Genesis Setup Key (>= 24 chars). If blank on first boot, a random one-time key is printed to terminal.
GENESIS_SETUP_KEY=

# Reverse Proxy (set to 1 when behind Nginx / Cloudflare so Wi-Fi IP Allowlist sees real client IP)
TRUST_PROXY=0

# Dynamic QR Rotation (recommended 5-8 seconds to prevent photo/video-call relay)
QR_ROTATE_SECONDS=7
QR_MAX_AGE_SECONDS=10

# Local SQLite database directory
DATA_DIR=./data

# Local Offline Testing ONLY (NEVER enable in production!)
# The server refuses to start with this on if NODE_ENV=production or PUBLIC_BASE_URL is not localhost.
DEMO_MOCK_AUTH=false
